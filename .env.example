# Copy to .env.local — never commit secrets.
# Empty values are valid only for local development. Every Netlify context
# requires persistent DB, auth and AI configuration and fails closed otherwise.

# Public, browser-visible configuration (never put secrets in VITE_*).
VITE_AUTH_ENABLED=false
VITE_PUBLIC_HOSTNAME=

# Core server configuration.
DATABASE_URL=
XAI_API_KEY=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:8080

# Optional dedicated salt for persistent guest IP quotas. In Netlify, Helix
# safely falls back to BETTER_AUTH_SECRET when this is left empty.
GUEST_RATE_LIMIT_SALT=

# Required on Netlify. Random 32+ character secret used only for authenticated
# dispatch from the TanStack server/sweeper to the background queue worker.
HELIX_QUEUE_DISPATCH_SECRET=

# OAuth broker used by Helix (Google and X are broker upstreams).
# Direct GOOGLE_* / APPLE_* OAuth variables are not implemented by this app.
GROK_AUTH_ISSUER=https://auth.grok.me
GROK_AUTH_CLIENT_ID=
GROK_AUTH_CLIENT_SECRET=

# Required on Netlify because personal GitHub linking is currently visible to
# authenticated users. Use a random 32-byte key encoded as base64url. Changing
# the version/key invalidates existing envelopes and requires an explicit relink.
GITHUB_TOKEN_ENCRYPTION_KEY=
GITHUB_TOKEN_KEY_VERSION=v1

# Optional isolated Playwright service. Both values must be configured together.
# The shared secret signs requests and responses; never expose it to the browser.
# Without this service Twin, Echo and Swift are reported honestly as NOT_RUN.
HELIX_BROWSER_RUNNER_URL=
HELIX_BROWSER_RUNNER_SECRET=

# Optional isolated Production workspace validator. Both values must be set
# together. The service must execute the fixed validation profile in a
# disposable container and return hash-bound, signed evidence. Production
# generation remains unavailable when this runner is absent.
HELIX_WORKSPACE_RUNNER_URL=
HELIX_WORKSPACE_RUNNER_SECRET=

# Optional packaging credentials. Their presence alone never means that a
# store upload has happened or that a package is ready.
APPLE_TEAM_ID=
PLAY_SERVICE_JSON=
EXPO_TOKEN=

# Optional realtime/PWA metadata.
VITE_STUN_URLS=
VITE_PROJECT_ID=
VITE_OG_SERVICE_URL=https://og.grok.me
X_CREATOR=
X_CREATOR_ID=
