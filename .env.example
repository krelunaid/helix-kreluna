# Copy to .env.local — never commit secrets.
# Empty values are valid only for local development. Every Netlify context
# requires persistent DB, auth and AI configuration and fails closed otherwise.

# Public, browser-visible configuration (never put secrets in VITE_*).
VITE_AUTH_ENABLED=false
VITE_PUBLIC_HOSTNAME=

# Production generation is exposed only when authentication, a signed isolated
# workspace runner and an explicit per-build credit price are all configured.
VITE_PRODUCTION_BUILDS_ENABLED=false
VITE_PRODUCTION_CREDITS=

# Core server configuration.
DATABASE_URL=
XAI_API_KEY=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:8080

# Optional dedicated salt for persistent guest IP quotas. In Netlify, Helix
# safely falls back to BETTER_AUTH_SECRET when this is left empty.
GUEST_RATE_LIMIT_SALT=

# Required on Netlify. Random 32+ character secret used only for authenticated
# dispatch from the TanStack server/sweeper to the background queue worker.
HELIX_QUEUE_DISPATCH_SECRET=

# Optional Stripe billing. The complete group is required when enabled; a
# partial configuration fails closed. Hosted Checkout does not need a public
# publishable key, so every value remains server-only.
STRIPE_BILLING_ENABLED=false
# Set to `test` or `live` only when billing is enabled.
# STRIPE_MODE=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STANDARD=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=
STRIPE_PRICE_EXTRA_50=
# Required when billing is enabled. Helix retrieves this exact Stripe Portal
# configuration and permits a session only when the live provider response
# proves that cancellation-at-period-end is the sole enabled portal feature.
STRIPE_PORTAL_CONFIGURATION_ID=

# Separate 32+ character credential for dispatching verified, durably queued
# Stripe events to the Netlify background worker. Never use the webhook secret.
HELIX_BILLING_DISPATCH_SECRET=

# Optional real Warden monitoring. When enabled the complete group is required.
# The adapter uses an authenticated HTTPS source, binds every response to the
# configured adapter/source identity, and persists snapshot/report/alert evidence.
# It never applies dependency updates, deploys, publishes, or rolls back.
HELIX_WARDEN_ENABLED=false
HELIX_WARDEN_ADAPTER_ID=
HELIX_WARDEN_SOURCE_ID=
HELIX_WARDEN_SOURCE_URL=
HELIX_WARDEN_SOURCE_TOKEN=
# JSON object matching the documented Warden threshold policy schema.
HELIX_WARDEN_POLICY_JSON=
# Positive milliseconds, at most 30 days.
HELIX_WARDEN_ALERT_DEDUP_TTL_MS=
# Separate random 32+ character credential for scheduled -> background dispatch.
HELIX_WARDEN_DISPATCH_SECRET=

# Optional Nimbus provider/quote evidence source. The complete group is required
# when any value is set. Candidate/quote envelopes must be HMAC-authenticated,
# fresh, and bound to the exact Production requirements/workspace hashes.
HELIX_NIMBUS_EVIDENCE_URL=
HELIX_NIMBUS_EVIDENCE_TOKEN=
HELIX_NIMBUS_EVIDENCE_SOURCE_ID=
HELIX_NIMBUS_EVIDENCE_KEY_ID=
HELIX_NIMBUS_EVIDENCE_HMAC_SECRET=
HELIX_NIMBUS_EVIDENCE_MAX_AGE_MS=

# Optional Augur capacity evidence source. The complete group is required when
# any value is set. Helix accepts only fresh HMAC-authenticated bundles bound to
# the current owned build and its exact deployed web-output hash. Without this
# group Augur remains honestly NOT_RUN and no capacity row or score is changed.
HELIX_AUGUR_EVIDENCE_URL=
HELIX_AUGUR_EVIDENCE_TOKEN=
HELIX_AUGUR_EVIDENCE_SOURCE_ID=
HELIX_AUGUR_EVIDENCE_KEY_ID=
HELIX_AUGUR_EVIDENCE_HMAC_SECRET=
HELIX_AUGUR_EVIDENCE_MAX_AGE_MS=

# OAuth broker used by Helix (Google and X are broker upstreams).
# Direct GOOGLE_* / APPLE_* OAuth variables are not implemented by this app.
GROK_AUTH_ISSUER=https://auth.grok.me
GROK_AUTH_CLIENT_ID=
GROK_AUTH_CLIENT_SECRET=

# Required on Netlify because personal GitHub linking is currently visible to
# authenticated users. Use a random 32-byte key encoded as base64url. Changing
# the version/key invalidates existing envelopes and requires an explicit relink.
GITHUB_TOKEN_ENCRYPTION_KEY=
GITHUB_TOKEN_KEY_VERSION=v1

# Optional isolated Playwright service. Both values must be configured together.
# The shared secret signs requests and responses; never expose it to the browser.
# Without this service Twin, Echo and Swift are reported honestly as NOT_RUN.
HELIX_BROWSER_RUNNER_URL=
HELIX_BROWSER_RUNNER_SECRET=
# Required by `npm run qa:twin:service`. The isolated runner refuses to listen
# without this durable PostgreSQL replay authority; there is no memory fallback.
HELIX_BROWSER_RUNNER_REPLAY_DATABASE_URL=

# Optional isolated Production workspace validator. Both values must be set
# together. The service must execute the fixed validation profile in a
# disposable container and return hash-bound, signed evidence. Production
# generation remains unavailable when this runner is absent.
HELIX_WORKSPACE_RUNNER_URL=
HELIX_WORKSPACE_RUNNER_SECRET=

# Optional authenticated Store runner used only after an explicit submission
# confirmation. Source-package downloads do not require it and remain free.
HELIX_STORE_RUNNER_URL=
HELIX_STORE_RUNNER_SECRET=

# Store-runner service configuration (set on the isolated runner, not in the
# Helix/Netlify application). The executable refuses startup without durable
# PostgreSQL state, an exact eas-cli pin, an Expo token and at least one
# non-secret per-app credential mapping. Each mapping must explicitly set
# `easCredentialsPreuploaded: true`: signing and submission credentials,
# including the Google service-account key, must be uploaded to the exact EAS
# project before the runner is enabled. The runner never accepts a local key
# path or embeds a credential file in a source ZIP.
HELIX_STORE_RUNNER_DATABASE_URL=
HELIX_STORE_EAS_CLI_PATH=
HELIX_STORE_EAS_CLI_VERSION=
HELIX_STORE_EXPO_ACCOUNT_ID=
HELIX_STORE_IOS_CREDENTIALS_JSON=
HELIX_STORE_ANDROID_CREDENTIALS_JSON=
EXPO_TOKEN=
HELIX_STORE_RUNNER_HOST=127.0.0.1
HELIX_STORE_RUNNER_PORT=8790

# Optional realtime/PWA metadata.
VITE_STUN_URLS=
VITE_PROJECT_ID=
VITE_OG_SERVICE_URL=https://og.grok.me
X_CREATOR=
X_CREATOR_ID=
