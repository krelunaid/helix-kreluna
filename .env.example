# Copy to .env.local — never commit secrets.

# xAI / Grok
XAI_API_KEY=

# Database (leave empty to use PGLite in the browser / local)
DATABASE_URL=

# Auth (Better Auth)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:8080

# OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Public site
VITE_PUBLIC_ORIGIN=http://localhost:8080
